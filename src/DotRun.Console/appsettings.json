{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "DotRun": "Debug"
    },
    "Console": {
      "DisableColors": false,
      "IncludeScopes": true
    }
  },
  "DotRun": {
    "LogLevel": "Information",
    "TimeoutSeconds": 3600,
    "DryRun": false,
    "EnableTelemetry": false
  }
}