@model DotRun.WebServer.Models.WorkflowBrowserViewModel
@{
    ViewData["Title"] = "Workflows";
}

<div class="page-container">
    <nav aria-label="breadcrumb" class="breadcrumb-nav">
        <ol class="breadcrumb">
            @foreach (var item in Model.BreadcrumbItems)
            {
                if (item == Model.BreadcrumbItems.Last())
                {
                    <li class="breadcrumb-item active" aria-current="page">@item.Name</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="/workflows/@item.Path" class="breadcrumb-link">@item.Name</a>
                    </li>
                }
            }
        </ol>
    </nav>

    <div class="content-container">
        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <p>No items found</p>
            </div>
        }
        else
        {
            <div class="list-container">
                <h2 class="section-title">Workflows</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="table-header">Name</th>
                            <th class="table-header table-header-narrow">Type</th>
                            <th class="table-header table-header-date">Last modified</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="table-row">
                                <td class="table-cell table-cell-primary">
                                    <a href="/workflows/@item.Path" class="item-link">
                                        <span class="item-icon">
                                            @if (item.IsDirectory)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                </svg>
                                            }
                                        </span>
                                        <span class="item-name">@item.Name</span>
                                    </a>
                                </td>
                                <td class="table-cell table-cell-type">
                                    @if (item.IsDirectory)
                                    {
                                        <span>Folder</span>
                                    }
                                    else
                                    {
                                        <span>Workflow</span>
                                    }
                                </td>
                                <td class="table-cell table-cell-date">
                                    <span>-</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>